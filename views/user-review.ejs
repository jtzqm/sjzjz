<div class="page-header"><h1>用户审核</h1></div>
<h2>待审核用户</h2>
<table class="table">
  <thead><tr><th>账号</th><th>昵称</th><th>注册时间</th><th>操作</th></tr></thead>
  <tbody>
    <% unverified.forEach(function(u) { %>
    <tr>
      <td><%= u.username %></td>
      <td><%= u.nickname||'' %></td>
      <td><%= u.created_at %></td>
      <td>
        <form method="POST" action="/users/<%= u.id %>/approve" style="display:inline"><button type="submit" class="btn btn-sm btn-primary">通过</button></form>
        <form method="POST" action="/users/<%= u.id %>/reject" style="display:inline" onsubmit="return confirm('确认拒绝？')"><button type="submit" class="btn btn-sm btn-danger">拒绝</button></form>
      </td>
    </tr>
    <% }) %>
    <% if (unverified.length === 0) { %><tr><td colspan="4" class="empty">暂无待审核用户</td></tr><% } %>
  </tbody>
</table>

<h2>已审核用户</h2>
<table class="table">
  <thead><tr><th>账号</th><th>昵称</th><th>角色</th><th>注册时间</th></tr></thead>
  <tbody>
    <% verified.forEach(function(u) { %>
    <tr>
      <td><%= u.username %></td>
      <td><%= u.nickname||'' %></td>
      <td><%= {admin:'管理员',verified:'已审核'}[u.role]||u.role %></td>
      <td><%= u.created_at %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
