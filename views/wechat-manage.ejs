<div class="page-header"><h1>微信群管理</h1></div>
<form method="POST" action="/wechats/groups/add" class="form-inline" style="margin-bottom:1rem">
  <input name="name" placeholder="输入群名称" required>
  <select name="type"><option value="微信群">微信群</option><option value="企业微信群">企业微信群</option></select>
  <button type="submit" class="btn btn-primary btn-sm">添加</button>
</form>
<table class="table">
  <thead><tr><th>群名称</th><th>类型</th><th>操作</th></tr></thead>
  <tbody>
    <% groups.forEach(function(g) { %>
    <tr>
      <td><%= g.name %></td><td><%= g.type %></td>
      <td><form method="POST" action="/wechats/groups/delete" style="display:inline" onsubmit="return confirm('确认删除「<%= g.name %>」？')"><input type="hidden" name="name" value="<%= g.name %>"><button type="submit" class="btn btn-sm btn-danger">删除</button></form></td>
    </tr>
    <% }) %>
    <% if (groups.length===0) { %><tr><td colspan="3" class="empty">暂无群，在上方添加</td></tr><% } %>
  </tbody>
</table>
<p style="color:#888;font-size:0.85rem">在微信群管理添加的群名称会出现在新建订单的选项里</p>
