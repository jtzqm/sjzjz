<div class="page-header"><h1>俱乐部管理</h1></div>
<form method="POST" action="/clubs/add" class="form-inline" style="margin-bottom:1rem">
  <input name="name" placeholder="输入俱乐部名称" required>
  <button type="submit" class="btn btn-primary btn-sm">添加</button>
</form>
<table class="table">
  <thead><tr><th>俱乐部名称</th><th>关联订单数</th><th>操作</th></tr></thead>
  <tbody>
    <% clubs.forEach(function(c) { %>
    <tr>
      <td><%= c.name %></td>
      <td><%= c.cnt %></td>
      <td><% if (user.role === 'admin') { %>
        <form method="POST" action="/clubs/delete" style="display:inline" onsubmit="return confirm('确认删除「<%= c.name %>」？')">
          <input type="hidden" name="name" value="<%= c.name %>"><button type="submit" class="btn btn-sm btn-danger">删除</button>
        </form>
      <% } %></td>
    </tr>
    <% }) %>
    <% if (clubs.length===0) { %><tr><td colspan="3" class="empty">暂无俱乐部</td></tr><% } %>
  </tbody>
</table>
