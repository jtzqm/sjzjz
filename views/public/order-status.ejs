<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body { background:#f4f7f6; margin:0; padding:1rem; font-family:sans-serif; }
    .status-page { max-width:640px; margin:0 auto; }
    .status-header, .status-card { background:#fff; border-radius:10px; padding:1.25rem; margin-bottom:1rem; box-shadow:0 2px 12px rgba(0,0,0,.08); }
    .status-header h1 { margin:0 0 .75rem; font-size:1.35rem; }
    .status-meta { color:#666; font-size:.9rem; line-height:1.8; }
    .status-card h2 { margin:0 0 .75rem; font-size:1.05rem; }
    .status-card table { width:100%; border-collapse:collapse; }
    .status-card td { padding:.55rem 0; border-bottom:1px solid #eee; }
    .status-card td:first-child { color:#666; width:35%; }
    .back-link { display:inline-block; margin-top:.25rem; color:#2563eb; text-decoration:none; }
  </style>
</head>
<body>
  <main class="status-page">
    <section class="status-header">
      <h1>订单进度</h1>
      <div class="status-meta">订单号：<strong><%= order.order_number || '-' %></strong><br>客户：<%= order.wechat_name || '-' %><br>状态：<span class="status status-<%= order.status %>"><%= order.status==='active'?'进行中':order.status==='completed'?'已完成':'提前结单' %></span></div>
      <div style="margin-top:1rem;display:flex;gap:.75rem;flex-wrap:wrap">
        <a class="btn btn-primary" href="/public/orders/<%= order.id %>/print?token=<%= order.query_token %>" target="_blank">🖨️ 打印派单</a>
        <button type="button" class="btn" onclick="genQR()">📱 生成二维码</button>
        <a class="back-link" href="/public/track">查询其他订单</a>
      </div>
      <div id="qrPanel" style="display:none;margin-top:1rem;text-align:center;border:1px dashed #ddd;border-radius:10px;padding:1rem;background:#fafbfc">
        <img id="qrImg" alt="查询二维码" style="width:200px;height:200px;border-radius:8px;background:#fff">
        <span id="qrLink" style="color:#666;font-size:.72rem;word-break:break-all;display:block;margin:.6rem 0"></span>
        <button type="button" class="btn" onclick="copyLink()">复制链接</button>
        <div style="color:#999;font-size:.74rem;margin-top:.3rem">客户扫码即可直接查看订单进度并打印派单</div>
      </div>
    </section>
    <section class="status-card">
      <h2>订单信息</h2>
      <table><tr><td>需求总数</td><td><%= order.total_harfbux %> M</td></tr><tr><td>微信群</td><td><%= order.order_wechat_name || '-' %></td></tr><tr><td>分配手机</td><td><%= order.phone_number ? order.phone_number + '号' : '-' %></td></tr></table>
    </section>
    <section class="status-card">
      <h2>交易记录</h2>
      <% if (transactions.length === 0) { %><p style="color:#888">暂无交易记录</p><% } else { %>
      <table><% transactions.forEach(function(t) { %><tr><td><%= t.date %></td><td>完成 <%= t.change_amount %> M</td><td>剩余 <%= t.balance_difference %> M</td></tr><% }) %></table>
      <% } %>
    </section>
    </main>
    <script>
    function genQR() {
      var panel = document.getElementById('qrPanel');
      var num = '<%= order.order_number %>';
      var tok = '<%= order.query_token %>';
      document.getElementById('qrImg').src = '/public/qrcode?order_number=' + encodeURIComponent(num) + '&query_token=' + encodeURIComponent(tok);
      document.getElementById('qrLink').textContent = location.origin + '/public/track?order_number=' + num + '&query_token=' + tok;
      panel.style.display = 'block';
    }
    function copyLink() {
      navigator.clipboard.writeText(document.getElementById('qrLink').textContent).then(function () { alert('链接已复制'); });
    }
    </script>
</body>
</html>
