<div class="page-header"><h1>进行中订单</h1><a href="/orders/new" class="btn btn-primary">新建订单</a></div>
<div style="margin-bottom:0.8rem;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap">
  <input id="searchInput" type="text" placeholder="🔍 搜索客户名称..." oninput="filterOrders()" style="padding:0.4rem 0.7rem;border:1px solid #ddd;border-radius:4px;width:200px;font-size:0.9rem">
  <input id="phoneSearchInput" type="text" placeholder="📱 搜索手机..." oninput="filterOrders()" style="padding:0.4rem 0.7rem;border:1px solid #ddd;border-radius:4px;width:150px;font-size:0.9rem">
  <select id="paymentSelect" onchange="filterOrders()" style="padding:0.4rem 0.7rem;border:1px solid #ddd;border-radius:4px;font-size:0.9rem">
    <option value="all">收款详情</option>
    <option value="paid">已收款</option>
    <option value="unpaid">未收款</option>
  </select>
  <select id="clubSelect" onchange="filterOrders()" style="padding:0.4rem 0.7rem;border:1px solid #ddd;border-radius:4px;font-size:0.9rem">
    <option value="">全部俱乐部</option>
    <% clubs.forEach(function(c) { %>
    <option value="<%= c %>" <%= selectedClub===c?'selected':'' %>><%= c %></option>
    <% }) %>
  </select>
  <button onclick="exportCSV()" class="btn btn-success" style="padding:0.4rem 0.7rem;border:none;border-radius:4px;font-size:0.9rem;cursor:pointer;background:#28a745;color:white">导出 CSV</button>
</div>
<table class="table" id="ordersTable">
  <thead><tr><th>序号</th><th>订单号</th><th>查询验证码</th><th>客户</th><th>游戏ID</th><th>手机</th><th>微信群</th><th>需求(M)</th><th>已收款(元)</th><th>俱乐部</th><th>创建时间</th><th>操作</th></tr></thead>
  <tbody>
    <% orders.forEach(function(o) { %>
    <tr class="order-row">
      <td><%= o.sequence %></td>
      <td class="order-number"><%= o.order_number||'-' %></td>
      <td><strong><%= o.query_token||'-' %></strong><br><button type="button" class="btn btn-sm" onclick="copyQueryInfo('<%= o.order_number||'' %>', '<%= o.query_token||'' %>')">复制查询信息</button></td>
      <td><a href="/customers/<%= o.customer_id %>"><%= o.wechat_name %></a <% if(o.login_method && o.login_method.trim()){ %>(<%= o.login_method.trim() %>)<% }else{ %><span style="color:#ccc">(未设置)</span><% } %></td>
      <td><%= o.order_game_id||'-' %></td>
      <td><%= o.phone_number||'-' %>号</td>
      <td><%= o.order_wechat_name||'-' %></td>
      <td><%= o.total_harfbux %>M</td>
      <td><%= o.received_amount||0 %></td>
      <td><%= o.club_name||'-' %></td>
      <td><%= o.created_at %></td><td><a href="/orders/<%= o.id %>" class="btn btn-sm">详情</a></td>
    </tr>
    <% }) %>
    <% if (orders.length===0) { %><tr><td colspan="12" class="empty">暂无进行中的订单</td></tr><% } %>
  </tbody>
</table>
<script>
function filterOrders(){
  var nameVal=document.getElementById("searchInput").value.toLowerCase();
  var phoneVal=document.getElementById("phoneSearchInput").value;
  var paymentVal=document.getElementById("paymentSelect").value;
  var clubVal=document.getElementById("clubSelect").value;
  document.querySelectorAll("#ordersTable .order-row").forEach(function(r){
    var cells=r.querySelectorAll("td");
    var matchName=nameVal===""||r.textContent.toLowerCase().indexOf(nameVal)>-1;
    var matchPhone=phoneVal===""||(cells[5] && cells[5].textContent.indexOf(phoneVal)>-1);
    var matchPayment=true;
    if(paymentVal==="paid"){
      var received=parseFloat(cells[8].textContent)||0;
      matchPayment=received>0;
    } else if(cells[6] && paymentVal==="unpaid"){
      var received=parseFloat(cells[8].textContent)||0;
      var demand=parseFloat(cells[7].textContent)||0;
      matchPayment=received===0 && demand!==0;
    }
    var matchClub=true;
    if(clubVal!==""){
      var clubCell=cells[9];
      matchClub=clubCell && clubCell.textContent===clubVal;
    }
    r.style.display=(matchName && matchPhone && matchPayment && matchClub)?"":"none";
  });
}

function exportCSV() {
  const table = document.getElementById("ordersTable");
  let csv = [];
  const rows = table.querySelectorAll("tr");
  
  for (let i = 0; i < rows.length; i++) {
    // Only include visible rows
    if (rows[i].style.display === "none") continue;
    
    const row = [], cols = rows[i].querySelectorAll("td, th");
    for (let j = 0; j < cols.length; j++) {
      // Clean text: remove newlines and escape quotes
      let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/"/g, '""');
      row.push('"' + data + '"');
    }
    csv.push(row.join(","));
  }

  const csvContent = "\uFEFF" + csv.join("\n"); // Add BOM for Excel UTF-8 support
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement("a");
  const url = URL.createObjectURL(blob);
  link.setAttribute("href", url);
  link.setAttribute("download", "active_orders_" + new Date().toISOString().slice(0,10) + ".csv");
  link.style.visibility = 'hidden';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

function copyQueryInfo(orderNumber, queryToken) {
  navigator.clipboard.writeText('订单号: ' + orderNumber + ' | 验证码: ' + queryToken).then(function() {
    alert('查询信息已复制');
  });
}
</script>
