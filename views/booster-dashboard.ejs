<h2>我的派单</h2>
<p class="muted">仅显示分配给你的手机编号下的进行中订单。</p>

<% if (orders.length === 0) { %>
  <p>当前没有分配给你的进行中订单。</p>
<% } else { %>
  <table class="table">
    <thead><tr><th>订单号</th><th>客户</th><th>游戏ID</th><th>需求(M)</th><th></th></tr></thead>
    <tbody>
    <% orders.forEach(function(o){ %>
      <tr>
        <td><%= o.order_number || ('#'+o.id) %></td>
        <td><%= o.wechat_name %></td>
        <td><%= o.order_game_id || '—' %></td>
        <td><%= o.total_harfbux %></td>
        <td><a class="btn btn-sm btn-primary" href="/booster/orders/<%= o.id %>">进入</a></td>
      </tr>
    <% }); %>
    </tbody>
  </table>
<% } %>
