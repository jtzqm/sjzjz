<div class="page-header"><h1>个人信息</h1></div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/profile" class="form">
    <label>账号<input value="<%= user.username %>" disabled></label>
    <label>角色<input value="<%= {admin:'管理员',verified:'已审核用户',unverified:'待审核'}[user.role]||user.role %>" disabled></label>
    <label>昵称<input name="nickname" value="<%= user.nickname||'' %>"></label>
    <hr>
    <label>原密码<input type="password" name="old_password" placeholder="不改密码留空"></label>
    <label>新密码<input type="password" name="new_password" placeholder="不改密码留空"></label>
    <button type="submit" class="btn btn-primary">保存</button>
  </form>
</div>
