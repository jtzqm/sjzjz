<div class="page-header"><h1>新增客户</h1><a href="/customers" class="btn">返回</a></div>
<form method="POST" action="/customers/new" class="form">
  <label>客户编号<input name="customer_number" value="<%= nextNum %>" required></label>
  <label>微信名<input name="wechat_name"></label>
  <label>登陆方式<select name="login_method"><option value="QQ">QQ</option><option value="微信">微信</option></select></label>
  <label>游戏ID<input name="game_id"></label>
  <label>客户地区<input name="region" placeholder="如：江苏"></label>
  <label>实际加速地<input name="acceleration_location" placeholder="如：江苏电信A区"></label>
  <label>备注<textarea name="notes" rows="2"></textarea></label>
  <button type="submit" class="btn btn-primary">保存</button>
</form>
