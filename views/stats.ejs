<div class="page-header"><h1>已结单付款统计</h1></div>

<!-- 月份筛选 -->
<form method="GET" action="/stats" style="margin:1.5rem 0;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap">
  <label style="font-weight:600">选择月份：</label>
  <select name="month" id="monthSelect" style="padding:0.5rem;border:1px solid #ddd;border-radius:4px;font-size:0.95rem">
    <option value="">全部月份</option>
    <% availableMonths.forEach(function(m) { %>
    <option value="<%= m.month %>" <%= selectedMonth===m.month?'selected':'' %>><%= m.month %></option>
    <% }) %>
  </select>
  <button type="submit" style="padding:0.5rem 1.25rem;background:#4CAF50;color:white;border:none;border-radius:4px;cursor:pointer;font-size:0.95rem">筛选</button>
  <% if (selectedMonth) { %>
  <a href="/stats" style="padding:0.5rem 1.25rem;background:#666;color:white;text-decoration:none;border-radius:4px;font-size:0.95rem">清除筛选</a>
  <% } %>
</form>

<% if (monthlyStats.length>0) { %>
<h2 style="margin-top:2rem"><%= selectedMonth ? selectedMonth+' 月' : '' %>按月分类统计</h2>
<table class="table">
  <thead><tr><th>月份</th><th>结单数</th><th>收款(元)</th><th>付打手(元)</th><th>纯利润(元)</th></tr></thead>
  <tbody>
    <% monthlyStats.forEach(function(m) { %>
    <tr style="<%= selectedMonth===m.month?'background:#e8f5e9':'' %>">
      <td><%= m.month %></td>
      <td><%= m.count %></td>
      <td><%= m.received.toFixed(2) %></td>
      <td><%= m.handler.toFixed(2) %></td>
      <td><%= (m.received-m.handler).toFixed(2) %></td>
    </tr>
    <% }) %>
  </tbody>
  <tfoot><tr style="font-weight:700;background:#f0f0f0">
    <td colspan="2">合计（<%= monthlyStats.length %> 个月）</td>
    <td><%= monthlyStats.reduce(function(s,m){return s+m.received;},0).toFixed(2) %></td>
    <td><%= monthlyStats.reduce(function(s,m){return s+m.handler;},0).toFixed(2) %></td>
    <td><%= (monthlyStats.reduce(function(s,m){return s+m.received;},0)-monthlyStats.reduce(function(s,m){return s+m.handler;},0)).toFixed(2) %></td>
  </tr></tfoot>
</table>
<% } %>

<h2 style="margin-top:2rem">全部订单明细</h2>
<table class="table">
  <thead><tr><th>月份</th><th>客户</th><th>游戏ID</th><th>手机</th><th>微信群</th><th>需求(M)</th><th>已收款(元)</th><th>付打手(元)</th><th>俱乐部</th><th>结单方式</th><th>还欠(M)</th><th>结单时间</th><th>纯利润(元)</th></tr></thead>
  <tbody>
    <% completedOrders.forEach(function(o) { %>
    <tr>
      <td><%= o.completed_at ? o.completed_at.slice(0,7) : '-' %></td>
      <td><a href="/orders/<%= o.id %>"><%= o.wechat_name %></a></td>
      <td><%= o.order_game_id||'-' %></td>
      <td><%= o.phone_number||'-' %>号</td>
      <td><%= o.order_wechat_name||'-' %></td>
      <td><%= o.total_harfbux %>M</td>
      <td><%= o.received_amount||0 %></td>
      <td><%= o.handler_amount||0 %></td>
      <td><%= o.club_name||'-' %></td>
      <td><span class="status status-<%= o.status %>"><%= o.status==='completed'?'正常结单':'提前结单' %></span></td>
      <td><%= o.early_remaining_harfbux||'-' %></td>
      <td><%= o.completed_at||'' %></td>
      <td><%= (o.received_amount||0)-(o.handler_amount||0) %></td>
    </tr>
    <% }) %>
    <% if (completedOrders.length===0) { %><tr><td colspan="13" class="empty">暂无已结单且有付款记录的订单</td></tr><% } %>
  </tbody>
  <% if (completedOrders.length>0) { %>
  <tfoot><tr style="font-weight:700;background:#f0f0f0">
    <td colspan="6">合计（<%= completedOrders.length %> 笔订单）</td>
    <td><%= completedOrders.reduce(function(s,o){return s+(o.received_amount||0);},0).toFixed(2) %></td>
    <td><%= completedOrders.reduce(function(s,o){return s+(o.handler_amount||0);},0).toFixed(2) %></td>
    <td colspan="3"></td>
    <td><%= (completedOrders.reduce(function(s,o){return s+(o.received_amount||0);},0)-completedOrders.reduce(function(s,o){return s+(o.handler_amount||0);},0)).toFixed(2) %></td>
  </tr></tfoot>
  <% } %>
</table>
<p style="color:#888;font-size:0.85rem;margin-top:1rem">仅显示已结单且有付款记录的订单</p>
