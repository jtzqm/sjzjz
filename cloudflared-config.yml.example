# ============================================================================
# Cloudflare Tunnel 配置模板（命名隧道 / 用你已托管的域名）
# 用法：填好下面两处 <> 占位符后，保存到服务器 ~/.cloudflared/config.yml
#       （推荐直接跑 sudo bash setup-tunnel.sh，它会自动生成这份文件）
#
# 设计原则：最小暴露面
#   放行：/public/*（客户查询、二维码、打印派单）+ /styles.css
#   拦截：后台 /login、/orders 与打手端 /booster... 一律不出公网
#
# 说明：Cloudflare 边缘终止 HTTPS，origin 走 localhost:3000 明文即可（本机回路）。
#       隧道是服务器主动出向连边缘节点 —— 不需要公网 IP，也不需要 DDNS。
# ============================================================================

# 隧道 ID（cloudflared tunnel create delta-track 输出）
tunnel: <TUNNEL_ID>
# 凭据文件（create 后自动生成在 ~/.cloudflared/<TUNNEL_ID>.json）
credentials-file: /root/.cloudflared/<TUNNEL_ID>.json

ingress:
  # 客户查询：/public/track、/public/qrcode、/public/orders/:id/print
  - hostname: track.yourdomain.com
    path: /public/*
    service: http://localhost:3000

  # 样式表挂在根路径（express.static 挂的是 /），不放行会让客户看到无样式的裸页面
  - hostname: track.yourdomain.com
    path: /styles.css
    service: http://localhost:3000

  # 兜底：其它一切路径返回 404（后台、打手端不出公网）
  - service: http_status:404

# ----------------------------------------------------------------------------
# 别忘了：把公网地址写进 .env，否则二维码会按访问者的地址生成，
# 打手在内网点生成就会编出 http://192.168.x.x:3000/... ，客户扫码打不开。
#
#   echo 'PUBLIC_BASE_URL=https://track.yourdomain.com' >> /opt/delta-accounting/.env
#   systemctl restart delta-accounting
# ----------------------------------------------------------------------------
