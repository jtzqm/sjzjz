# 复制本文件为 .env 后按需修改。
# .env 不会被提交到仓库（已在 .gitignore 中），不要把它推上去。

PORT=3000

# 会话密钥：请改成一长串随机值（部署脚本会自动生成）
SESSION_SECRET=change-me-to-a-long-random-string

# 初始管理员账号：部署后登录并立即修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 客户从公网访问的地址，用于生成查询二维码，例如：
#   PUBLIC_BASE_URL=https://track.yourdomain.com
# 留空则按访问者自己的地址推断 —— 若打手在内网(192.168.x.x)生成二维码，
# 客户扫出来就是内网地址，打不开。公网部署务必填写。
PUBLIC_BASE_URL=
